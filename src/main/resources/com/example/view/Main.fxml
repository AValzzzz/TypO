<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.example.view.RichTextArea?>

<AnchorPane fx:controller="com.example.controller.InputController"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #D3D3D3;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <StackPane fx:id="stackPane" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <VBox fx:id="pagesContainer" alignment="CENTER" spacing="20.0">
               <children>
                  <Pane fx:id="whitePane" prefHeight="842.0" prefWidth="595.0"
                        minWidth="595.0" minHeight="842.0"
                        maxHeight="842.0" maxWidth="595.0"
                        style="-fx-background-color: #FFFFFF; -fx-background-position: center;">
                     <children>
                        <RichTextArea fx:id="textEditor" layoutX="0.0" layoutY="0.0"
                                              prefWidth="595.0" prefHeight="842.0"
                                              wrapText="true"
                                              style="-fx-background-color: transparent; -fx-padding: 20; -fx-font-size: 14px;" />
                     </children>
                  </Pane>
               </children>
            </VBox>
         </children>
      </StackPane>

      <HBox spacing="10.0" AnchorPane.topAnchor="15.0" AnchorPane.leftAnchor="15.0">
         <children>
            <Button fx:id="saveButton" text="Save" onAction="#handleSave" />
            <Button fx:id="saveAsButton" text="Save As" onAction="#handleSaveAs" />
            <Button fx:id="newPageButton" text="New Page" onAction="#handleNewPage" />
            <Button fx:id="helpButton" text="Help" onAction="#handleHelp" />
            <Button fx:id="settingsButton" text="Settings" onAction="#handleSettings" />
         </children>
      </HBox>
   </children>
</AnchorPane>